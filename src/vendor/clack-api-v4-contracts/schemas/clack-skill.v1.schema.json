{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clack.kr/schemas/platform/clack.skill.v1.schema.json",
  "$comment": "모노레포 clack-api-v4/contracts/platform/schemas/clack-skill.v1.schema.json에서 복사한 파일이다. 이 파일을 직접 수정하지 말고 scripts/sync-vendor-types.mjs로 갱신한다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "type": {
      "type": "string",
      "enum": [
        "instruction",
        "template",
        "tool"
      ]
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "object",
          "properties": {
            "ko": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "ko"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "properties": {
            "ko": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "ko"
          ],
          "additionalProperties": false
        },
        "icon": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
          },
          "maxItems": 10
        },
        "category": {
          "type": "string",
          "enum": [
            "character_chat",
            "quiz",
            "worldbuilding",
            "gallery",
            "story",
            "agent_tool"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "description": {
          "type": "object",
          "properties": {
            "ko": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "ko"
          ],
          "additionalProperties": false
        },
        "tags_i18n": {
          "type": "object",
          "properties": {
            "en": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        "release_notes": {
          "type": "object",
          "properties": {
            "ko": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "ko"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "summary",
        "category"
      ],
      "dependentRequired": {
        "tags_i18n": [
          "tags"
        ]
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "template",
              "agent"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "center",
              "app",
              "cli"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "form": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "ai_fill": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tiers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "economy",
                  "performance"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "default_tier": {
              "type": "string",
              "enum": [
                "economy",
                "performance"
              ]
            }
          },
          "required": [
            "enabled"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
          },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tool": {
                "const": "image.generate"
              },
              "max_calls": {
                "type": "integer",
                "minimum": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "aspect": {
                "type": "string",
                "pattern": "^(?:slot|[1-9][0-9]*:[1-9][0-9]*)$"
              },
              "batch_max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "references": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "allow": {
                    "type": "boolean"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "session",
                        "content_ref"
                      ]
                    },
                    "uniqueItems": true,
                    "minItems": 1
                  }
                },
                "required": [
                  "allow",
                  "sources"
                ]
              }
            },
            "required": [
              "tool",
              "max_calls",
              "purpose"
            ]
          },
          "maxItems": 8
        },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bundle": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "getFormSchema",
                  "getFormValues",
                  "setFormValues",
                  "listApprovedAssets",
                  "requestAssetUpload"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "bundle",
            "sha256",
            "fields",
            "permissions",
            "purpose"
          ]
        },
        "editor": {
          "type": "object",
          "additionalProperties": false,
          "description": "스킬 에디터(전체 화면 제작 UI) 선언. v1은 template 스킬 전용이며 제작 폼·플러그인 패널과 함께 쓸 수 없다. 번들 규칙(디렉터리면 {bundle}/index.html 진입, sha256 계산법)은 authoring.plugin과 같다.",
          "properties": {
            "bundle": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "document.read",
                  "document.write",
                  "assets.read",
                  "assets.pick",
                  "ai.suggest",
                  "tools.image.generate",
                  "preview",
                  "package"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            },
            "purpose": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ko": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "ko"
              ]
            }
          },
          "required": [
            "bundle",
            "sha256",
            "permissions",
            "purpose"
          ]
        },
        "common": {
          "type": "object",
          "additionalProperties": false,
          "description": "공통 캐릭터 정보 수신 선언. 규격 clack.character.common v1: 센터가 한 번 입력한 공통 정보(fields)·콘텐츠 정보(listing)·공통 이미지(images)·인트로 첫 장면 연결 대상(opening)을 이 템플릿의 어느 폼 필드로 받을지 정합니다. 선언한 템플릿만 한 콘텐츠에 여러 개 연결하는 목록에 나옵니다. 폼 스킬(modes에 template, editor 없음) 전용이며 대상 필드의 가시성·위젯·상한은 의미 검사가 규격과 대조합니다.",
          "properties": {
            "spec": {
              "const": "clack.character.common"
            },
            "spec_version": {
              "type": "integer",
              "minimum": 1
            },
            "format": {
              "type": "string",
              "enum": [
                "dialogue_box",
                "messenger",
                "novel",
                "other"
              ]
            },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "tagline": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "appearance": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "personality": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "speech_style": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "background": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "relationship": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "prohibitions": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              },
              "required": [
                "name",
                "tagline"
              ]
            },
            "listing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rating": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "tags": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "source_work": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              }
            },
            "images": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "portrait": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "cover": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "gallery": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              }
            },
            "opening": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          },
          "required": [
            "spec",
            "spec_version",
            "format",
            "fields"
          ]
        }
      },
      "required": [
        "modes",
        "surfaces"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_kind": {
          "type": "string",
          "enum": [
            "html",
            "gallery",
            "slideshow"
          ]
        },
        "discovery_category": {
          "type": "string",
          "enum": [
            "character_chat",
            "quiz",
            "worldbuilding",
            "gallery",
            "story",
            "agent_tool"
          ]
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
            },
            "entry": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
            }
          },
          "required": [
            "root",
            "entry"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "description": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "thumbnail": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}(?:\\[(?:0|[1-9][0-9]*)\\])?$"
            },
            "thumbnail_fallback": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}(?:\\[(?:0|[1-9][0-9]*)\\])?$"
            }
          },
          "required": [
            "title"
          ]
        },
        "asset_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
              },
              "types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              },
              "multiple": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 24
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\{n\\}[A-Za-z0-9_./-]*$"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "path"
                ]
              }
            },
            "required": [
              "field",
              "types",
              "max_bytes"
            ],
            "oneOf": [
              {
                "required": [
                  "path"
                ],
                "not": {
                  "required": [
                    "multiple"
                  ]
                }
              },
              {
                "required": [
                  "multiple"
                ],
                "not": {
                  "required": [
                    "path"
                  ]
                }
              }
            ]
          }
        },
        "derive": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "join": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "item": {
                "type": "string",
                "maxLength": 1000
              },
              "separator": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "target",
              "join",
              "item",
              "separator"
            ]
          }
        },
        "profile_select": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "map": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,31}$"
                },
                "uniqueItems": true
              }
            }
          },
          "required": [
            "field",
            "map"
          ]
        },
        "entity": {
          "const": "character"
        },
        "entity_map": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "summary": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "portrait": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}(?:\\[(?:0|[1-9][0-9]*)\\])?$"
            },
            "exports": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "uniqueItems": true,
              "maxItems": 60
            }
          },
          "required": [
            "name"
          ]
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "header_mode": {
              "enum": [
                "fixed",
                "scroll_hide",
                "translucent_scroll_hide",
                "floating_close",
                "floating_close_safe_area"
              ]
            },
            "color_scheme": {
              "enum": [
                "light",
                "dark"
              ]
            }
          },
          "required": [
            "schema_version",
            "header_mode",
            "color_scheme"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "description": "스킬 에디터가 만드는 데이터 문서 선언. schema 파일은 output-data.v1 규칙을 따른다. 번들에는 공개 부분이 data/document.json, 비공개 최상위 키가 .clack/config.private.json, 자산이 data/assets/로 들어간다.",
          "properties": {
            "schema": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 262144
            },
            "private_max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "assets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 48
                },
                "max_total_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 25165824
                }
              },
              "required": [
                "max_count",
                "max_total_bytes"
              ]
            }
          },
          "required": [
            "schema"
          ]
        },
        "intro": {
          "type": "object",
          "additionalProperties": false,
          "description": "콘텐츠 인트로(실행 전 기본 정보 화면) 출력 선언. 모든 키는 선택이다. creator_comment·description은 공개 문자열 폼 필드(최대 길이 500·5000 이하), description_fallback은 description 값이 비었을 때 순서대로 값이 있는 필드만 '{폼 필드 title}\\n{값}'을 빈 줄로 이어 상세 설명을 자동 구성할 문자열 폼 필드다(비공개 필드를 공개하는 유일한 명시 예외, 최대 길이 합과 라벨이 5000자 이하). images는 output.asset_slots의 field이며 슬롯 순서대로 펼친 제작 자산을 쓴다(단일 1장·multiple은 max장으로 세어 합계 8 이하). 폼 스킬 전용이며 에디터 스킬·지침형(instruction) 스킬은 쓸 수 없다.",
          "properties": {
            "default_enabled": {
              "type": "boolean",
              "default": false
            },
            "creator_comment": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "description": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "description_fallback": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
