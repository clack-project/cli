{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clack.kr/schemas/platform/authoring-form.v1.schema.json",
  "$comment": "모노레포 clack-api-v4/contracts/platform/schemas/authoring-form.v1.schema.json에서 복사한 파일이다. 이 파일을 직접 수정하지 말고 scripts/sync-vendor-types.mjs로 갱신한다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "object",
        "string",
        "integer",
        "number",
        "boolean",
        "array"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "default": {},
    "enum": {
      "type": "array",
      "items": {},
      "minItems": 1
    },
    "minLength": {
      "type": "integer",
      "minimum": 0
    },
    "maxLength": {
      "type": "integer",
      "minimum": 1
    },
    "minimum": {
      "type": "number"
    },
    "maximum": {
      "type": "number"
    },
    "minItems": {
      "type": "integer",
      "minimum": 0
    },
    "maxItems": {
      "type": "integer",
      "minimum": 1
